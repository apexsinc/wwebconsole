# Cloudflare Workers secrets (set via `wrangler secret put`, never commit real values)
SESSION_SECRET=
CREDENTIALS_KEY=

# Local / staging (.dev.vars) — same keys work in wrangler.jsonc vars for deploy
APP_URL=http://localhost:5173
ADMIN_EMAIL=apexsinc@gmail.com
# Comma-separated allowlist (prod + local/staging). These accounts auto-promote to admin on login.
ADMIN_EMAILS=apexsinc@gmail.com,demo@wwebconsole.com
