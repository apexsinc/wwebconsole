# =============================================================================
# WWebConsole environment template
# =============================================================================
# Copy this file to create your local secrets file:
#
#   cp .env.example .env
#
# Then fill in real values. NEVER commit `.env` or `.dev.vars`.
#
# How values are used:
#   - Local/dev:  copy relevant keys into `.dev.vars` (Wrangler/Vite reads that)
#                 OR keep a single `.env` and run: `npm run env:sync-dev`
#   - Production: put secrets with `npm run secrets:push` (wrangler secret put)
#                 Non-secret public vars stay in wrangler.jsonc `vars`.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare account (deploy / D1 / Access / WAF scripts)
# -----------------------------------------------------------------------------
# Account ID: Cloudflare dashboard → Workers → Overview (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# API token with: Workers Scripts Edit, D1 Edit, Account Settings Read.
# For `npm run waf:rate-limits` also need: Zone → Zone WAF → Edit
# (and Access Edit if you run scripts/setup-admin-access.sh).
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Zone ID for wwebconsole.com (optional; auto-detected by WAF script if unset)
# Dashboard → Domain → Overview → Zone ID
# ZONE_ID=your_zone_id

# Cloudflare website plan for the WAF helper (default: free)
# free = 1 rate-limit rule, 10s windows (cf.colo.id + ip.src)
# pro|business|enterprise = multi-rule set in scripts/setup-waf-rate-limits.sh
# CF_PLAN=free

# -----------------------------------------------------------------------------
# Public app vars (safe to put in wrangler.jsonc `vars` for production)
# -----------------------------------------------------------------------------
APP_NAME=WWebConsole
# Production site URL (no trailing slash)
APP_URL=https://wwebconsole.com
# Local only — used when syncing to .dev.vars for `npm run dev`
LOCAL_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Worker secrets (REQUIRED in production — never commit real values)
# Push with: npm run secrets:push
# -----------------------------------------------------------------------------
# Long random string used to HMAC-sign session cookies
SESSION_SECRET=replace_with_long_random_string_at_least_32_chars

# 32-byte key as 64 hex characters — encrypts WeatherLink credentials at rest
# Generate: openssl rand -hex 32
CREDENTIALS_KEY=replace_with_64_char_hex_from_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Admin allowlist (OPTIONAL as Worker secrets — recommended)
# These emails auto-promote to admin on LOGIN only (cannot self-register).
# Prefer secrets over wrangler.jsonc so addresses are not in git.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=you@example.com
ADMIN_EMAILS=you@example.com,ops@example.com

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection on auth forms)
# Dashboard: https://dash.cloudflare.com → Turnstile
# -----------------------------------------------------------------------------
# Public site key (also stored in D1 app_settings.turnstile_site_key for the widget)
TURNSTILE_SITE_KEY=0x4AAAAA_your_turnstile_site_key

# Secret key — MUST be a Worker secret (TURNSTILE_SECRET_KEY), not only D1
TURNSTILE_SECRET_KEY=0x4AAAAA_your_turnstile_secret_key

# 1 = require Turnstile on login/register/reset (production should be 1)
TURNSTILE_ENABLED=1

# -----------------------------------------------------------------------------
# Resend (email OTP for verify / password reset / email change)
# Dashboard: https://resend.com → API Keys
# -----------------------------------------------------------------------------
# Leave empty until you have a key; RESEND_ENABLED must stay 0 without a key.
RESEND_API_KEY=re_your_resend_api_key

# From address (domain must be verified in Resend)
RESEND_FROM_EMAIL=WWebConsole <noreply@wwebconsole.com>

# 1 = require email verification + send OTPs (needs RESEND_API_KEY)
RESEND_ENABLED=0

# -----------------------------------------------------------------------------
# Local / development only (do not set in production Worker secrets)
# -----------------------------------------------------------------------------
# ENVIRONMENT=development
# ALLOW_DEV_OTP=1
