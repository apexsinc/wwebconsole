# Cloudflare Workers secrets (set via `wrangler secret put`, never commit real values)
SESSION_SECRET=replace-with-long-random-string
CREDENTIALS_KEY=replace-with-64-char-hex-32-byte-key

# Optional Worker secrets (preferred over D1 for integration keys)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Local / staging (.dev.vars) — never commit real values
APP_URL=http://localhost:5173
ADMIN_EMAIL=you@example.com
# Comma-separated allowlist. These accounts promote to admin on login (not on register).
ADMIN_EMAILS=you@example.com

# Dev-only: allow OTP codes in API responses when Resend is off
# ALLOW_DEV_OTP=1
# ENVIRONMENT=development
