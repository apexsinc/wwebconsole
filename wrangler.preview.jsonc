{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwebconsole-preview",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wwebconsole-preview-db",
      "database_id": "9724e63c-cfb0-455e-a9d1-ae3a42ababe9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Weatherlink Web Console (Preview)",
    "APP_URL": "https://wwebconsole-preview.apexsinc.workers.dev",
    "ADMIN_EMAILS": "apexsinc@gmail.com,demo@wwebconsole.com"
  }
}
