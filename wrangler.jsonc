{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwebconsole",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  // Disabled: the workers.dev hostname served the full app (including /admin)
  // and bypassed both the zone WAF rules and the Cloudflare Access policy that
  // protects the admin portal. Only the custom domains below are public.
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      // Persist so console.error from failure paths (e.g. Google OAuth token
      // exchange failures) is queryable in the dashboard instead of being
      // discarded at the edge. Without this, diagnosing a login failure is
      // guesswork.
      "persist": true
    },
    // OAuth callbacks carry `code`/`state` and reset links carry tokens.
    // Never persist query strings.
    "redact_query_string": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wwebconsole-db",
      "database_id": "200fe3df-5df3-4851-81ce-1987c5acb7aa",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "wwebconsole-cdn"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "routes": [
    { "pattern": "wwebconsole.com", "custom_domain": true },
    { "pattern": "www.wwebconsole.com", "custom_domain": true },
    { "pattern": "api.wwebconsole.com", "custom_domain": true },
    { "pattern": "admin.wwebconsole.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "Weatherlink Web Console",
    "APP_URL": "https://wwebconsole.com",
    "API_URL": "https://api.wwebconsole.com",
    "ADMIN_EMAILS": "apexsinc@gmail.com"
  }
}
