{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwebconsole",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wwebconsole-db",
      "database_id": "200fe3df-5df3-4851-81ce-1987c5acb7aa",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "routes": [
    { "pattern": "wwebconsole.com", "custom_domain": true },
    { "pattern": "www.wwebconsole.com", "custom_domain": true },
    { "pattern": "admin.wwebconsole.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "WWebConsole",
    "APP_URL": "https://wwebconsole.com",
    "ADMIN_EMAIL": "apexsinc@gmail.com",
    "ADMIN_EMAILS": "apexsinc@gmail.com,it.apexsinc@gmail.com,ts.apexsinc@gmail.com,demo@wwebconsole.com,contact@apexsinc.com"
  }
}
