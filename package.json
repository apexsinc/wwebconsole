{
  "name": "wwebconsole",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'); for (const p of ['dist/wwebconsole/.dev.vars','dist/client/.dev.vars']) { try { fs.unlinkSync(p); } catch {} }\"",
    "preview": "vite preview",
    "deploy": "vite build && node -e \"const fs=require('fs'); for (const p of ['dist/wwebconsole/.dev.vars','dist/client/.dev.vars']) { try { fs.unlinkSync(p); } catch {} }\" && wrangler deploy",
    "env:sync-dev": "bash scripts/env-sync-dev.sh",
    "secrets:push": "bash scripts/secrets-push.sh",
    "waf:rate-limits": "bash scripts/setup-waf-rate-limits.sh",
    "db:migrate:local": "wrangler d1 migrations apply wwebconsole-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wwebconsole-db --remote",
    "cf:typegen": "wrangler types",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test worker/__tests__/security.test.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.2",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "hono": "^4.12.28",
    "lucide-react": "^1.24.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "suncalc": "^2.0.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/suncalc": "^1.9.2",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "wrangler": "^4.107.1"
  }
}
