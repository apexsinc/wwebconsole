{
  "name": "wwebconsole",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'); for (const p of ['dist/wwebconsole/.dev.vars','dist/client/.dev.vars']) { try { fs.unlinkSync(p); } catch {} }\"",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "env:sync-dev": "bash scripts/env-sync-dev.sh",
    "secrets:push": "bash scripts/secrets-push.sh",
    "waf:rate-limits": "bash scripts/setup-waf-rate-limits.sh",
    "db:migrate:local": "wrangler d1 migrations apply wwebconsole-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wwebconsole-db --remote",
    "cf:typegen": "wrangler types",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test worker/__tests__/*.test.ts",
    "test:ui": "node --test ui/*.test.cjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "date-fns": "^4.4.0",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "suncalc": "^2.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.1",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
